# Copy to .env (next to manage.py) and adjust. Never commit .env.

# development | staging | production
# Staging and production refuse DJANGO_DEBUG=true and keep their secret key in the data folder.
# Ready-made templates: deploy/staging.env.example and deploy/production.env.example.
SEHATDESK_ENV=development

# Debug pages. Development only.
DJANGO_DEBUG=true

# Optional. Without it, staging/production create DATA_DIR/secret.key on first start.
# To set one explicitly, generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Hostnames the server answers to. Add the server's LAN IP for the fallback setup.
SEHATDESK_ALLOWED_HOSTS=sehatdesk.local,localhost,127.0.0.1
SEHATDESK_CSRF_TRUSTED_ORIGINS=http://sehatdesk.local

# Plain HTTP on the LAN for the pilot. Set true once HTTPS is in place.
SEHATDESK_SECURE_COOKIES=false
# Set true once a TLS proxy terminates HTTPS in front of the server: turns on secure cookies,
# https redirect, HSTS (SEHATDESK_HSTS_SECONDS, default one year) and trusts X-Forwarded-Proto.
SEHATDESK_HTTPS=false

# Uncomment to override the default data folder (./data).
# SEHATDESK_DATA_DIR=/path/to/data

SEHATDESK_TIME_ZONE=Asia/Karachi
SEHATDESK_LOG_LEVEL=INFO
SEHATDESK_PORT=8000

# Sign out after this many idle minutes.
SEHATDESK_SESSION_IDLE_MINUTES=60
# Lock a username + computer after this many failed sign-ins, for this many minutes.
SEHATDESK_LOGIN_FAILURE_LIMIT=5
SEHATDESK_LOCKOUT_MINUTES=15

# Optional SMTP for "Forgot password" emails. Leave empty to reset passwords via an administrator.
SEHATDESK_EMAIL_HOST=
# SEHATDESK_EMAIL_PORT=587
# SEHATDESK_EMAIL_USER=
# SEHATDESK_EMAIL_PASSWORD=
# SEHATDESK_EMAIL_TLS=true
# SEHATDESK_EMAIL_FROM=

# Patient documents. Max upload size in MB, and how long a document link stays valid.
# SEHATDESK_DOCUMENT_MAX_MB=15
# SEHATDESK_DOCUMENT_LINK_SECONDS=300
# Object storage for documents (optional, needs django-storages), e.g.:
# SEHATDESK_DOCUMENT_STORAGE=storages.backends.s3.S3Storage
# SEHATDESK_DOCUMENT_STORAGE_OPTIONS={"bucket_name": "sehatdesk-docs", "default_acl": "private"}

# Backups (docs/BACKUP_AND_RECOVERY.md). serve.py backs up every N hours; 0 = off.
# SEHATDESK_BACKUP_HOURS=24
# SEHATDESK_BACKUP_KEEP=14
# SEHATDESK_BACKUP_DIR=
# Encryption key from `python manage.py backup --generate-key`. Keep a copy off this computer.
# SEHATDESK_BACKUP_KEY=

# Logs: text (default) or json. Staging/production also write DATA_DIR/logs/sehatdesk.log.
# SEHATDESK_LOG_FORMAT=text
# Optional PostgreSQL instead of SQLite (pip install -r requirements-postgres.txt):
# SEHATDESK_DATABASE_URL=postgres://sehatdesk:secret@localhost:5432/sehatdesk
