# SehatDesk PRODUCTION configuration (hospital server).
# The installer launcher writes the real file and secret into the data folder
# (docs/PROJECT_NOTES.md §3). For a manual install, copy this file, fill it in, and point
# SEHATDESK_ENV_FILE at it. Check it before go-live:
#   SEHATDESK_ENV_FILE=/path/to/production.env python manage.py check --deploy --fail-level WARNING

SEHATDESK_ENV=production
# Must stay false: the server refuses to start with debug pages on.
DJANGO_DEBUG=false

# Leave empty: the server creates DATA_DIR/secret.key (owner-only) on first start and keeps
# using it. Back it up with the data folder. To set one explicitly (50+ random characters):
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=

# Windows: %LOCALAPPDATA%\SehatDesk   macOS: ~/Library/Application Support/SehatDesk
# Holds the database, uploads, private documents, logs/sehatdesk.log. Back up the whole folder.
# SEHATDESK_DATA_DIR=

# Add the server's static LAN IP (and its http:// origin) for the hosts-file fallback.
SEHATDESK_ALLOWED_HOSTS=sehatdesk.local,localhost,127.0.0.1
SEHATDESK_CSRF_TRUSTED_ORIGINS=http://sehatdesk.local
SEHATDESK_PORT=80

# Plain HTTP on the LAN for the pilot. Set SEHATDESK_HTTPS=true (and use https:// origins above)
# once a TLS proxy is in front of the server.
SEHATDESK_HTTPS=false
SEHATDESK_SECURE_COOKIES=false
# SEHATDESK_HSTS_SECONDS=31536000

SEHATDESK_TIME_ZONE=Asia/Karachi
SEHATDESK_LOG_LEVEL=WARNING

SEHATDESK_SESSION_IDLE_MINUTES=60
SEHATDESK_LOGIN_FAILURE_LIMIT=5
SEHATDESK_LOCKOUT_MINUTES=15

# Optional SMTP for "Forgot password" emails.
SEHATDESK_EMAIL_HOST=

# Backups: daily, keep 14, encrypted. Generate the key with
#   python manage.py backup --generate-key
# and store a printed copy in the safe: without it encrypted backups cannot be restored.
SEHATDESK_BACKUP_HOURS=24
SEHATDESK_BACKUP_KEEP=14
SEHATDESK_BACKUP_KEY=
