# SehatDesk STAGING configuration.
# Staging = the release build on a test machine with demo data, used to try a version before it
# reaches a hospital. Copy to deploy/staging.env (gitignored), then run:
#   SEHATDESK_ENV_FILE=deploy/staging.env python manage.py migrate
#   SEHATDESK_ENV_FILE=deploy/staging.env python manage.py collectstatic --noinput
#   SEHATDESK_ENV_FILE=deploy/staging.env python serve.py --port 8001
# Every page shows a "Staging" banner. Use demo data only, never a copy of a hospital database.

SEHATDESK_ENV=staging
DJANGO_DEBUG=false

# Leave empty: a key is created in the staging data folder on first start (secret.key).
DJANGO_SECRET_KEY=

# Own data folder so staging never touches development or production data.
SEHATDESK_DATA_DIR=./data-staging

SEHATDESK_ALLOWED_HOSTS=staging.sehatdesk.local,localhost,127.0.0.1
SEHATDESK_CSRF_TRUSTED_ORIGINS=http://staging.sehatdesk.local,http://localhost:8001
SEHATDESK_PORT=8001

SEHATDESK_HTTPS=false
SEHATDESK_SECURE_COOKIES=false

SEHATDESK_TIME_ZONE=Asia/Karachi
SEHATDESK_LOG_LEVEL=INFO

# Patient SMS / WhatsApp stay off in staging. Set true only to test a provider with test numbers.
SEHATDESK_STAGING_SEND_MESSAGES=false
